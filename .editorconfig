root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.{py,rs}]
indent_size = 4

[*.go]
indent_style = tab
indent_size = 4

[*.{h,hpp,cpp,cc,cxx}]
indent_size = 4

[{CMakeLists.txt,*.cmake}]
indent_size = 4
