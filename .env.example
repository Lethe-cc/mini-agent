# mini-agent configuration variables (names are examples; keep real
# credentials in a local .env or the shell environment, never committed).
# Copy to .env and source it, or export the variables directly.

# Environment variables (they override the config file; you can leave all of
# them unset and configure /provider /login /model inside `mini-agent run`,
# which writes ~/.config/mini-agent/config.json).
# Required: OpenAI-compatible Chat Completions service
MINI_AGENT_BASE_URL=https://api.openai.com/v1
MINI_AGENT_API_KEY=replace-with-your-key
MINI_AGENT_MODEL=gpt-4o-mini

# Optional: per-request total timeout in seconds, default 120
#MINI_AGENT_TIMEOUT_SECONDS=120

# Optional (v4): model context window in tokens for the TUI status-bar
# ctx% reading. Config is the authoritative source (no probing); unset
# means the bar shows token counts without a percentage. The TUI sets
# the same value live with /context <tokens> | off.
#MINI_AGENT_CONTEXT_WINDOW=128000

# Optional (v4): reasoning_effort passed through verbatim in every chat
# request (low|medium|high or a provider-specific value). Unset = field
# omitted (request shape identical to pre-v4). The TUI sets it with
# /reasoning <value> | off. Gateways that reject the field answer 400;
# the TUI then hints at /reasoning off.
#MINI_AGENT_REASONING_EFFORT=low

# Diagnostics log (key=value metadata lines; never writes the API key or
# message bodies). Enabled by default at /tmp/mini-agent-<uid>.log (0600);
# set a path to override, set "off" to disable. The TUI can switch live with
# /log <path> | off | default.
#MINI_AGENT_LOG=/tmp/mini-agent.log

# Optional (v4.4): raw chat-traffic debug dump. When set (any non-empty
# value), every chat completion appends its REQUEST body and each SSE
# payload line to "<log path>.debug" (0600). Model listing (/models) and
# the context-window probe are NEVER dumped. The api_key stays in the
# Authorization header only. The dump contains conversation content --
# that is the point of the flag -- so treat the file like a secret.
# TUI toggles live with /debug on|off; CLI flags: ask/run --debug.
#MINI_AGENT_DEBUG=1

# Optional: session storage directory, default $XDG_DATA_HOME/mini-agent/sessions
# (falls back to ~/.local/share/mini-agent/sessions when XDG is unset)
#MINI_AGENT_SESSION_DIR=
