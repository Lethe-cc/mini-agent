[project]
name = "@@PROJECT_NAME@@"
version = "0.1.0"
description = "Python starter application"
requires-python = ">=3.11"
dependencies = []

# This starter runs from the checkout; choose a build backend before distributing it.
[tool.ruff]
line-length = 100
target-version = "py311"

[tool.ruff.lint]
select = ["E", "F", "I"]
