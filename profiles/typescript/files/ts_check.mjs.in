// Use the current Node executable, not platform-specific npm shell wrappers.
import { spawnSync } from "node:child_process";
import { rmSync } from "node:fs";
import { fileURLToPath } from "node:url";

const root = fileURLToPath(new URL("../", import.meta.url));
const compiler = "node_modules/typescript/bin/tsc";
// dist is a generated output directory, never a source directory.
rmSync(new URL("../dist/", import.meta.url), { recursive: true, force: true });
for (const args of [[compiler, "--noEmit"], [compiler], ["--test"]]) {
  console.log("RUN", process.execPath, ...args);
  const result = spawnSync(process.execPath, args, {
    cwd: root,
    stdio: "inherit",
    shell: false,
    timeout: 120000,
  });
  if (result.error || result.status !== 0) {
    console.error(result.error ?? `Command failed: ${result.status ?? result.signal}`);
    process.exit(result.status || 1);
  }
}
